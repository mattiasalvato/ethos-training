---
interface FAQItem {
  question: string;
  answer: string;
}

const faqs: FAQItem[] = [
  {
    question: "Come funziona il Colloquio iniziale con anamnesi?",
    answer: "Nella fase iniziale effettuerai un colloquio con il Personal Trainer. È un momento dedicato ad analizzare la tua storia motoria, verificare eventuali problematiche posturali o articolari e definire obiettivi realistici prima di iniziare il percorso.",
  },
  {
    question: "Cosa comprende esattamente l'accesso per 12 mesi?",
    answer: "Comprende l'accesso annuale completo sia alla Sala Pesi (con l'assistenza continua del Personal Trainer sempre presente in sala), valutazione della situazione fisica, schede personalizzate con modifiche periodiche e accesso ai corsi Mini Class con il Metodo TriFit.",
  },
  {
    question: "Ogni quanto tempo viene aggiornata la scheda di allenamento?",
    answer: "La programmazione è individuale e sartoriale: ogni 6 settimane di frequenza costante il Personal Trainer aggiorna la tua scheda di allenamento in base ai carichi raggiunti e ai feedback registrati nel percorso.",
  },
  {
    question: "Ci sono opzioni di pagamento?",
    answer: "Sì, per rendere l'accesso più comodo abbiamo diverse opzioni di pagamento. Potrai parlarne direttamente con la nostra assistente in sede.",
  },
  {
    question: "Come funziona la Garanzia Soddisfatto o Rimborsato?",
    answer: "Se dopo 20 giorni non sei soddisfatto del nostro servizio potrai richiedere il reso della quota dell'abbonamento annuale.",
  },
  {
    question: "Come funziona la prenotazione degli ingressi tramite App?",
    answer: "Per azzerare code e sovraffollamento, la struttura accoglie un numero controllato di persone per fascia oraria. Tramite la nostra App potrai prenotare le Mini Class o la tua sessione in Sala Pesi garantendoti sempre spazio e attrezzi liberi.",
  },
];
---

<section id="faq" class="faq-section">
  <div class="container">
    
    <!-- Meta Bar Superiore -->
    <div class="section-meta">
      <span class="section-number">05 / DOMANDE FREQUENTI</span>
      <span class="section-tag">FAQ & Chiarezza</span>
    </div>

    <!-- Header Editoriale -->
    <div class="header-grid">
      <h2 class="section-title">
        Tutto Quello che<br />
        <span class="text-accent">Devi Sapere.</span>
      </h2>
      <p class="section-lead">
        Risposte dirette sull'assistenza in Sala Pesi, il Metodo TriFit, le opzioni di accesso e la garanzia di ammissione Founding Member.
      </p>
    </div>

    <!-- Lista Accordion -->
    <div class="faq-accordion">
      {faqs.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-question">
            <span>{faq.question}</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .faq-section {
    position: relative;
    background-color: #000000;
    color: #ffffff;
    padding: 5rem 1.5rem;
    border-bottom: 1px solid #1a1a1a;
    font-family: 'Inter', sans-serif;
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    width: 100%;
  }

  /* Section Meta */
  .section-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 1rem;
    margin-bottom: 2.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #737373;
  }

  .section-number {
    color: #069892;
    font-weight: 700;
  }

  /* Header */
  .header-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3.5rem;
    align-items: end;
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-family: 'Michroma', sans-serif;
    font-size: clamp(1.8rem, 3.8vw, 3rem);
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .text-accent {
    color: #069892;
  }

  .section-lead {
    font-size: 1rem;
    line-height: 1.7;
    color: #a3a3a3;
    margin: 0;
    border-left: 2px solid #004f5b;
    padding-left: 1.25rem;
  }

  /* Accordion */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 850px;
  }

  .faq-item {
    background-color: #050505;
    border: 1px solid #141414;
    border-radius: 0.25rem;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .faq-item[open] {
    border-color: #004f5b;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    font-family: 'Michroma', sans-serif;
    font-size: 0.9375rem;
    color: #ffffff;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-family: 'Inter', sans-serif;
    font-size: 1.25rem;
    color: #069892;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 1.5rem 1.25rem 1.5rem;
    border-top: 1px solid #111111;
  }

  .faq-answer p {
    font-size: 0.875rem;
    line-height: 1.65;
    color: #a3a3a3;
    margin: 1rem 0 0 0;
  }

  @media (max-width: 900px) {
    .header-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>