---
interface Props {
  maxSpots?: number;
  whatsappNumber?: string;
}

const {
  maxSpots = 30,
  whatsappNumber = "3773364103",
} = Astro.props;

const whatsappUrl = `https://wa.me/39${whatsappNumber}?text=${encodeURIComponent(
  "Ciao! Vorrei maggiori informazioni sulle ultime tessere Foundation Member con il 35% di sconto prima dell'apertura del 10 Ottobre."
)}`;

const schedule = [
  { days: "Lunedì – Venerdì", hours: "07:00 – 21:00", note: "Orario continuato" },
  { days: "Sabato", hours: "08:00 – 17:00", note: "" },
  { days: "Domenica", hours: "09:00 – 13:00", note: "" },
];

const inclusions = [
  {
    num: "01",
    title: "Valutazione Funzionale & Anamnesi",
    desc: "Test preliminare di mobilità e biomeccanica per individuare asimmetrie e definire gli obiettivi reali.",
  },
  {
    num: "02",
    title: "Sala con PT Costante (Rapporto 1:10)",
    desc: "Un coach sempre presente in sala a guidarti e correggere ogni singola ripetizione.",
  },
  {
    num: "03",
    title: "Sessioni Guidate & Metodo TriFit",
    desc: "Allenamento a piccoli gruppi contingentati per garantire spazio, progressione e massima attenzione.",
  },
  {
    num: "04",
    title: "Accesso su Prenotazione da App",
    desc: "Blocchi il tuo orario da smartphone: postazione sempre riservata, zero code e zero attese agli attrezzi.",
  },
];
---

<section id="offerta" class="pricing-section">
  <div class="container">
    
   
    <!-- Header Editoriale -->
    <div class="header-grid">
      <h2 class="section-title">
        Tariffa di Lancio.<br />
        <span class="text-accent">Ultime 30 Tessere.</span>
      </h2>
      <p class="section-lead">
        I primi 30 posti sono andati esauriti in prevendita. 
        Sblocchiamo le ultime <strong>{maxSpots} quote al -35%</strong> valide fino al <strong>9 Ottobre</strong> prima dell'apertura del 10 Ottobre.
      </p>
    </div>

    <!-- Griglia Principale -->
    <div class="pricing-grid">
      
      <!-- Box Quota Principale -->
      <div class="tier-card">
        <div class="tier-header">
          <div class="tier-badge-row">
            <span class="soldout-badge">1ª TRANCHE SOLD OUT</span>
            <span class="tier-saving-badge">-35% QUOTA LANCIO</span>
          </div>
          <h3 class="tier-name">Abbonamento All-Inclusive</h3>
          <p class="tier-sub">Sala assistita (1:10) + Sessioni guidate su prenotazione</p>
        </div>

        <!-- Blocco Vantaggio Lancio -->
        <div class="tier-promo-banner">
          <div class="promo-highlight">
            <span class="promo-title">Blocco Quota Agevolata</span>
            <p class="promo-desc">
              Accedi alla tariffa agevolata della seconda tranche. Valida esclusivamente fino al 9 Ottobre ore 23:59. Nessun pagamento online richiesto.
            </p>
          </div>
        </div>

        <!-- Protocollo Incluso -->
        <div class="inclusions-list">
          <span class="list-heading">Cosa include l'esperienza Ethos:</span>
          {inclusions.map((item) => (
            <div class="inc-row">
              <span class="inc-num">{item.num}</span>
              <div class="inc-text">
                <strong>{item.title}</strong>
                <p>{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="tier-actions">
          <a href="#preiscrizione" class="btn btn-solid">
            Richiedi Ammissione al -35%
          </a>
          <span class="limit-caption">Nessun pagamento anticipato &bull; Ultime {maxSpots} tessere fino al 9/10</span>
        </div>
      </div>

      <!-- Colonna Laterale: Orari & Supporto -->
      <div class="side-column">
        
        <!-- Orari -->
        <div class="side-card">
          <div class="card-meta">
            <span class="card-meta-tag">Disponibilità Struttura</span>
          </div>
          <h3 class="side-title">Orari di Apertura</h3>
          
          <div class="schedule-table">
            {schedule.map((slot) => (
              <div class="sched-row">
                <div class="sched-days">
                  <span>{slot.days}</span>
                  {slot.note && <small class="sched-note">{slot.note}</small>}
                </div>
                <strong class="sched-hours">{slot.hours}</strong>
              </div>
            ))}
          </div>
        </div>

        <!-- Supporto WhatsApp -->
        <div class="side-card side-card-support">
          <div class="card-meta">
            <span class="card-meta-tag">Canale Diretto</span>
          </div>
          <h3 class="side-title">Supporto Reception</h3>
          <p class="side-desc">
            Hai domande sul metodo, vuoi verificare le fasce orarie disponibili o fissare la tua visita prima del 10 Ottobre?
          </p>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            Scrivi al 377 3364103
          </a>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .pricing-section {
    position: relative;
    background-color: #000000;
    color: #ffffff;
    padding: 5rem 1.5rem;
    border-bottom: 1px solid #1a1a1a;
    font-family: 'Inter', sans-serif;
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    width: 100%;
  }

  .section-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 1rem;
    margin-bottom: 2.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #737373;
  }

  .section-number {
    color: #069892;
    font-weight: 700;
  }

  .header-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3.5rem;
    align-items: end;
    margin-bottom: 4.5rem;
  }

  .section-title {
    font-family: 'Michroma', sans-serif;
    font-size: clamp(1.8rem, 3.8vw, 3rem);
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .text-accent {
    color: #069892;
  }

  .section-lead {
    font-size: 1rem;
    line-height: 1.7;
    color: #a3a3a3;
    margin: 0;
    border-left: 2px solid #004f5b;
    padding-left: 1.25rem;
  }

  .section-lead strong {
    color: #ffffff;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .tier-card {
    background-color: #050505;
    border: 1px solid #1f1f1f;
    border-left: 3px solid #069892;
    border-radius: 0.35rem;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
  }

  .tier-header {
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .tier-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .soldout-badge {
    background: rgba(255, 255, 255, 0.08);
    color: #a3a3a3;
    font-family: 'Inter', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.6rem;
    border-radius: 0.2rem;
  }

  .tier-saving-badge {
    background-color: #069892;
    color: #000000;
    font-family: 'Michroma', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.75rem;
    border-radius: 0.2rem;
  }

  .tier-name {
    font-family: 'Michroma', sans-serif;
    font-size: 1.35rem;
    text-transform: uppercase;
    margin: 0 0 0.4rem 0;
    color: #ffffff;
  }

  .tier-sub {
    font-size: 0.875rem;
    color: #737373;
    margin: 0;
  }

  .tier-promo-banner {
    background: linear-gradient(135deg, rgba(6, 152, 146, 0.1) 0%, rgba(0, 0, 0, 0.4) 100%);
    border: 1px solid rgba(6, 152, 146, 0.3);
    border-radius: 0.35rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.75rem;
  }

  .promo-title {
    display: block;
    font-family: 'Michroma', sans-serif;
    font-size: 1rem;
    color: #ffffff;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .promo-desc {
    font-size: 0.8125rem;
    color: #a3a3a3;
    line-height: 1.5;
    margin: 0;
  }

  .inclusions-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .list-heading {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #555555;
  }

  .inc-row {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .inc-num {
    font-family: 'Michroma', sans-serif;
    font-size: 0.8125rem;
    color: #069892;
    padding-top: 0.1rem;
  }

  .inc-text strong {
    display: block;
    font-size: 0.9rem;
    color: #ffffff;
    margin-bottom: 0.15rem;
  }

  .inc-text p {
    font-size: 0.8125rem;
    color: #888888;
    margin: 0;
    line-height: 1.45;
  }

  .tier-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .limit-caption {
    font-size: 0.6875rem;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #555555;
  }

  .side-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .side-card {
    background-color: #080808;
    border: 1px solid #141414;
    border-radius: 0.35rem;
    padding: 1.75rem;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .card-meta-tag {
    color: #555555;
  }

  .side-title {
    font-family: 'Michroma', sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
    margin: 0 0 1.25rem 0;
    color: #ffffff;
  }

  .schedule-table {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .sched-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.8125rem;
    border-bottom: 1px solid #141414;
    padding-bottom: 0.65rem;
  }

  .sched-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .sched-days {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    color: #a3a3a3;
  }

  .sched-note {
    font-size: 0.6875rem;
    color: #069892;
    text-transform: uppercase;
  }

  .sched-hours {
    color: #ffffff;
    font-weight: 600;
  }

  .side-desc {
    font-size: 0.8125rem;
    color: #888888;
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-radius: 0.25rem;
    transition: all 0.2s ease;
    cursor: pointer;
    width: 100%;
    text-align: center;
  }

  .btn-solid {
    background-color: #069892;
    color: #000000;
    border: 1px solid #069892;
    font-weight: 700;
  }

  .btn-solid:hover {
    background-color: #05807a;
    border-color: #05807a;
  }

  .btn-outline {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid #222222;
  }

  .btn-outline:hover {
    border-color: #069892;
    color: #069892;
  }

  @media (max-width: 900px) {
    .header-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 3.5rem;
    }

    .pricing-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .tier-card {
      padding: 1.75rem 1.25rem;
    }
  }
</style>