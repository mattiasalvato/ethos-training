---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="404 - Pagina Non Trovata | Ethos Training Club"
  description="La pagina che stai cercando non esiste o è stata spostata. Ritorna alla Home di Ethos Training Club."
>
  <main class="error-section">
    <div class="container">
      
      <!-- Meta Bar Superiore -->
      <div class="section-meta">
        <span class="section-number">ERRORE 404</span>
        <span class="section-tag">Fuori Rotta</span>
      </div>

      <!-- Contenuto Principale -->
      <div class="error-content">
        <span class="error-code">404</span>
        
        <h1 class="error-title">
          Pagina Fuori <span class="text-accent">Dalla Scheda.</span>
        </h1>

        <p class="error-desc">
          Il percorso che hai digitato non esiste, è stato rimosso oppure sei atterrato su una rotta non ancora attiva nel club.
        </p>

        <div class="cta-actions">
          <a href="/" class="btn btn-solid">
            &larr; Torna alla Home
          </a>
          <a href="https://wa.me/393773364103?text=Ciao!%20Ho%20trovato%20un%20errore%20404%20sul%20sito." target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            Scrivi alla Reception
          </a>
        </div>
      </div>

    </div>
  </main>
</Layout>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .error-section {
    min-height: 85vh;
    display: flex;
    align-items: center;
    background-color: #000000;
    color: #ffffff;
    padding: 6rem 1.5rem;
    font-family: 'Inter', sans-serif;
  }

  .container {
    max-width: 840px;
    margin: 0 auto;
    width: 100%;
  }

  .section-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 1rem;
    margin-bottom: 3.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #737373;
  }

  .section-number {
    color: #069892;
    font-weight: 700;
  }

  .error-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .error-code {
    font-family: 'Michroma', sans-serif;
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 1;
    font-weight: 700;
    color: #111111;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
    user-select: none;
    -webkit-text-stroke: 1px #004f5b;
  }

  .error-title {
    font-family: 'Michroma', sans-serif;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem 0;
  }

  .text-accent {
    color: #069892;
  }

  .error-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #a3a3a3;
    max-width: 580px;
    margin: 0 0 2.5rem 0;
    border-left: 2px solid #004f5b;
    padding-left: 1.25rem;
  }

  .cta-actions {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-radius: 0.25rem;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .btn-solid {
    background-color: #069892;
    color: #000000;
    border: 1px solid #069892;
  }

  .btn-solid:hover {
    background-color: #05807a;
    border-color: #05807a;
    transform: translateY(-1px);
  }

  .btn-outline {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid #222222;
  }

  .btn-outline:hover {
    border-color: #069892;
    color: #069892;
  }

  @media (max-width: 600px) {
    .error-section {
      padding: 4rem 1.25rem;
    }

    .cta-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>