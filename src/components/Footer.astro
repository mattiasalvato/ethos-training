---
interface Props {
  logoSrc?: string;
  email?: string;
  whatsappNumber?: string;
  address?: string;
  vatNumber?: string;
}

const {
  logoSrc = "/images/logo.svg",
  email = "info@ethostrainingclub.it",
  whatsappNumber = "3773364103",
  address = "Trissino (VI)",
  vatNumber = "IT00000000000",
} = Astro.props;

const whatsappUrl = `https://wa.me/39${whatsappNumber}?text=${encodeURIComponent(
  "Ciao! Vorrei maggiori informazioni su Ethos Training Club e sulle pre-iscrizioni."
)}`;
---

<footer class="site-footer">
  <div class="top-line"></div>

  <div class="container">
    
    <!-- Top Grid Section -->
    <div class="footer-grid">
      
      <!-- Brand Column -->
      <div class="col-brand">
        <a href="#" class="brand-link" aria-label="Torna all'inizio">
          <span class="brand-title">ETHOS</span>
          <span class="brand-sub">TRAINING CLUB</span>
        </a>
        <p class="brand-desc">
          Training Club focalizzato su Mini Class a numero chiuso e metodo TriFit. L'energia del piccolo gruppo, la precisione del Personal Training.
        </p>
        <div class="status-indicator">
          <span class="dot-live"></span>
          <span>Pre-Iscrizioni Founding Member Attive</span>
        </div>
      </div>

      <!-- Navigazione Veloce -->
      <div class="col-nav">
        <span class="col-heading">Navigazione</span>
        <ul class="nav-links">
          <li><a href="#metodo">Il Metodo TriFit</a></li>
          <li><a href="#club">Gli Spazi</a></li>
          <li><a href="#offerta">Quote & Founding Member</a></li>
          <li><a href="#faq">Domande Frequenti</a></li>
          <li><a href="#preiscrizione">Pre-Iscrizione Online</a></li>
        </ul>
      </div>

      <!-- Orari Struttura -->
      <div class="col-schedule">
        <span class="col-heading">Orari Club</span>
        <ul class="schedule-list">
          <li>
            <span class="day">Lun – Ven</span>
            <span class="hours">07:00 – 21:00 <small>(Continuato)</small></span>
          </li>
          <li>
            <span class="day">Sabato</span>
            <span class="hours">08:00 – 17:00</span>
          </li>
          <li>
            <span class="day">Domenica</span>
            <span class="hours">09:00 – 13:00</span>
          </li>
        </ul>
      </div>

      <!-- Contatti & Reception -->
      <div class="col-contact">
        <span class="col-heading">Contatti Diretti</span>
        <div class="contact-details">
          <div class="contact-item">
            <span class="contact-label">WhatsApp Reception</span>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-value highlight">
              +39 {whatsappNumber}
            </a>
          </div>

          <div class="contact-item">
            <span class="contact-label">Email Ufficiale</span>
            <a href={`mailto:${email}`} class="contact-value">
              {email}
            </a>
          </div>

          <div class="contact-item">
            <span class="contact-label">Sede</span>
            <span class="contact-value muted">{address}</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar (Legal & Copyright) -->
    <div class="footer-bottom">
      <div class="legal-left">
        <span>&copy; {new Date().getFullYear()} Ethos Training Club. Tutti i diritti riservati.</span>
        <span class="piva">P.IVA: {vatNumber}</span>
      </div>

      <div class="legal-links">
        <a href="/privacy-policy">Privacy Policy</a>
        <span class="separator">/</span>
        <a href="#cookie-settings" data-cc="show-preferencesModal">Cookie</a>
      </div>
    </div>

  </div>

  <!-- Floating Action Button WhatsApp (Mobile & Desktop) -->
  <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="floating-whatsapp" aria-label="Contattaci su WhatsApp">
    <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
    <span class="wa-text">Chatta con la Reception</span>
  </a>
</footer>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .site-footer {
    position: relative;
    background-color: #030303;
    color: #ffffff;
    padding: 5rem 1.5rem 2.5rem;
    font-family: 'Inter', sans-serif;
    border-top: 1px solid #141414;
  }

  .top-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #069892 50%, transparent);
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    width: 100%;
  }

  /* Footer 4-Column Grid */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.1fr 1.2fr;
    gap: 3rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid #141414;
  }

  /* Brand Column */
  .col-brand {
    display: flex;
    flex-direction: column;
  }

  .brand-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1;
    margin-bottom: 1.25rem;
  }

  .brand-title {
    font-family: 'Michroma', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.05em;
  }

  .brand-sub {
    font-size: 0.58rem;
    font-weight: 600;
    color: #069892;
    letter-spacing: 0.25em;
    margin-top: 0.25rem;
  }

  .brand-desc {
    font-size: 0.8125rem;
    color: #737373;
    line-height: 1.65;
    margin: 0 0 1.5rem 0;
    max-width: 300px;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.725rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #a3a3a3;
  }

  .dot-live {
    width: 6px;
    height: 6px;
    background-color: #069892;
    border-radius: 50%;
  }

  /* Headings */
  .col-heading {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #069892;
    margin-bottom: 1.25rem;
  }

  /* Nav Links */
  .nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-links a {
    font-size: 0.8125rem;
    color: #888888;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: #ffffff;
  }

  /* Schedule List */
  .schedule-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .schedule-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.8125rem;
    border-bottom: 1px solid #0d0d0d;
    padding-bottom: 0.5rem;
  }

  .schedule-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .schedule-list .day {
    color: #a3a3a3;
  }

  .schedule-list .hours {
    color: #ffffff;
    font-weight: 500;
  }

  .schedule-list small {
    color: #069892;
    font-size: 0.6875rem;
    text-transform: uppercase;
  }

  /* Contacts Column */
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .contact-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #555555;
  }

  .contact-value {
    font-size: 0.8125rem;
    color: #d4d4d4;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-value:hover {
    color: #069892;
  }

  .contact-value.highlight {
    color: #069892;
    font-weight: 600;
  }

  .contact-value.muted {
    color: #737373;
  }

  /* Bottom Bar */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    font-size: 0.75rem;
    color: #555555;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .legal-left {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .piva {
    color: #444444;
  }

  .legal-links {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .legal-links a {
    color: #555555;
    text-decoration: none;
    transition: color 0.2s ease;
    cursor: pointer;
  }

  .legal-links a:hover {
    color: #069892;
  }

  .separator {
    color: #333333;
  }

  /* Floating WhatsApp Button */
  .floating-whatsapp {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 99;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.15rem;
    background-color: #069892;
    color: #000000;
    border-radius: 9999px;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 700;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .floating-whatsapp:hover {
    transform: translateY(-2px);
    background-color: #05807a;
  }

  .wa-icon {
    width: 18px !important;
    height: 18px !important;
    flex-shrink: 0;
  }

  /* Responsive Breakpoints */
  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .site-footer {
      padding: 4rem 1.25rem 2rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .wa-text {
      display: none;
    }

    .floating-whatsapp {
      padding: 0.85rem;
      bottom: 20px;
      right: 20px;
    }
  }
</style>