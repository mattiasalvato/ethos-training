---
interface WIPItem {
  id: string;
  tag: string;
  title: string;
  desc: string;
  imageSrc: string;
}

interface Props {
  items?: WIPItem[];
}

const {
  items = [
    {
      id: "01",
      tag: "ATTREZZATURE NUOVE",
      title: "Pesi Liberi & Macchinari Isotonici",
      desc: "Nuova disposizione degli spazi, parco macchine professionale di ultima generazione con set completi di manubri e bilancieri nuovi.",
      imageSrc: "/images/ethostrainingclubmacchine.png",
    },
    {
      id: "02",
      tag: "IMPIANTI & FONDO TECNICO",
      title: "Pavimentazione & Binari LED",
      desc: "Posa del pavimento tecnico in gomma vulcanizzata ad alto assorbimento e installazione delle linee LED a soffitto per un fascio diffuso anti-riflesso.",
      imageSrc: "/images/ethostrainingclubtrissinopalestra.png",
    },
    {
      id: "03",
      tag: "HYBRID GYM DEDICATA",
      title: "Spazio Funzionale Dedicato",
      desc: "Area dedicata all'allenamento funzionale e ibrido con vogatori, slitta e postazioni cross-training.",
      imageSrc: "/images/ethostrainingclubhybridgym.png",
    },
  ]
} = Astro.props;
---

<section id="club" class="gallery-section">
  <div class="container">
    
    <!-- Meta Bar Superiore -->
    <div class="section-meta">
      <span class="section-number">03 / CANTIERE LIVE</span>
      <div class="live-status">
        <span class="dot-live"></span>
        <span>Avanzamento Lavori &bull; Trissino (VI)</span>
      </div>
    </div>

    <!-- Header Editoriale -->
    <div class="header-grid">
      <h2 class="section-title">
        Tutto Nuovo.<br />
        <span class="text-accent">Dietro le Quinte.</span>
      </h2>
      <p class="section-lead">
        Uno sguardo trasparente sull'allestimento di Ethos. Dalle nuove postazioni isotoniche al pavimento tecnico, fino all'area Hybrid Gym dedicata al condizionamento metabolico.
      </p>
    </div>

    <!-- Griglia Fotografica Pulita a 3 Elementi -->
    <div class="gallery-grid">
      {items.map((item) => (
        <article class="gallery-card">
          <div class="image-wrapper">
            <img 
              src={item.imageSrc} 
              alt={item.title} 
              class="card-img" 
              loading="lazy"
            />
            <span class="card-tag">{item.tag}</span>
          </div>

          <div class="card-body">
            <div class="card-header-row">
              <span class="card-num">{item.id}</span>
              <h3 class="card-title">{item.title}</h3>
            </div>
            <p class="card-desc">{item.desc}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .gallery-section {
    position: relative;
    background-color: #000000;
    color: #ffffff;
    padding: 5rem 1.5rem;
    border-bottom: 1px solid #1a1a1a;
    font-family: 'Inter', sans-serif;
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    width: 100%;
  }

  /* Section Meta */
  .section-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 1rem;
    margin-bottom: 2.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #737373;
  }

  .section-number {
    color: #069892;
    font-weight: 700;
  }

  .live-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #a3a3a3;
  }

  .dot-live {
    width: 6px;
    height: 6px;
    background-color: #069892;
    border-radius: 50%;
  }

  /* Header */
  .header-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3.5rem;
    align-items: end;
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-family: 'Michroma', sans-serif;
    font-size: clamp(1.8rem, 3.8vw, 3rem);
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .text-accent {
    color: #069892;
  }

  .section-lead {
    font-size: 1rem;
    line-height: 1.7;
    color: #a3a3a3;
    margin: 0;
    border-left: 2px solid #004f5b;
    padding-left: 1.25rem;
  }

  /* Griglia Cards */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .gallery-card {
    background-color: #050505;
    border: 1px solid #141414;
    border-radius: 0.25rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease;
  }

  .gallery-card:hover {
    border-color: #004f5b;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #0a0a0a;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%) contrast(105%);
    transition: transform 0.4s ease;
  }

  .gallery-card:hover .card-img {
    transform: scale(1.03);
  }

  .card-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background-color: rgba(0, 0, 0, 0.85);
    border: 1px solid #1f1f1f;
    color: #069892;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.6rem;
    border-radius: 0.2rem;
  }

  .card-body {
    padding: 1.5rem 1.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-header-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .card-num {
    font-family: 'Michroma', sans-serif;
    font-size: 0.75rem;
    color: #004f5b;
  }

  .card-title {
    font-family: 'Michroma', sans-serif;
    font-size: 0.9375rem;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.8125rem;
    color: #888888;
    line-height: 1.6;
    margin: 0;
  }

  /* Responsive Rules */
  @media (max-width: 900px) {
    .header-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 2.5rem;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .gallery-section {
      padding: 4rem 1.25rem;
    }

    .card-body {
      padding: 1.25rem 1rem 1.5rem;
    }
  }
</style>