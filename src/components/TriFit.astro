---
interface Pillar {
  id: string;
  title: string;
  subtitle: string;
  desc: string;
}

const pillars: Pillar[] = [
  {
    id: "01",
    title: "Valutazione Funzionale",
    subtitle: "Check-up iniziale & Anamnesi",
    desc: "Un colloquio dedicato e 20 minuti di test motorio per analizzare mobilità, postura e capacità di carico. Non si inizia mai alla cieca.",
  },
  {
    id: "02",
    title: "Programmazione Sartoriale",
    subtitle: "Scheda da 6 Settimane",
    desc: "Un protocollo di lavoro individuale calibrato sui tuoi obiettivi reali. La scheda viene costantemente riadattata durante il percorso.",
  },
  {
    id: "03",
    title: "Mini Class con Personal",
    subtitle: "2 Allenamenti a Settimana",
    desc: "La sinergia e la costanza del piccolo gruppo unite al controllo tecnico costante del trainer. Zero dispersioni, massima precisione.",
  },
];

const comparisonData = [
  {
    label: "Rapporto Trainer / Allievo",
    standard: "1 istruttore per 30–40 persone",
    ethos: "Mini Class ristrette a numero chiuso",
  },
  {
    label: "Personalizzazione",
    standard: "Schede preconfezionate e standard",
    ethos: "Anamnesi e scheda su misura da 6 settimane",
  },
  {
    label: "Valutazione Iniziale",
    standard: "Assente o solo burocratica",
    ethos: "Test funzionale di 20 minuti iniziale",
  },
  {
    label: "Gestione Spazi & Attese",
    standard: "Attese ai macchinari e sovraffollamento",
    ethos: "Postazione dedicata e accesso programmato",
  },
];
---

<section id="metodo" class="trifit-section">
  <div class="container">
    
    <!-- Intestazione Sezione Editoriale -->
    <div class="section-meta">
      <span class="section-number">02 / METODO</span>
      <span class="section-tag">Sistema TriFit</span>
    </div>

    <div class="header-grid">
      <h2 class="section-title">
        L'efficacia del Personal.<br />
        <span class="text-accent">L'energia della classe.</span>
      </h2>
      <p class="section-lead">
        Il sistema TriFit supera i limiti dei corsi affollati e delle schede generiche. 
        Ogni sessione in Mini Class è strutturata attorno al tuo livello di partenza e ai tuoi obiettivi individuali.
      </p>
    </div>

    <!-- I 3 Pilastri -->
    <div class="pillars-grid">
      {pillars.map((pillar) => (
        <div class="pillar-block">
          <div class="pillar-top">
            <span class="pillar-id">{pillar.id}</span>
            <span class="pillar-line"></span>
          </div>
          <div class="pillar-content">
            <span class="pillar-subtitle">{pillar.subtitle}</span>
            <h3 class="pillar-title">{pillar.title}</h3>
            <p class="pillar-desc">{pillar.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Tabella Comparativa Riprogettata ad Alto Contrasto -->
    <div class="comparison-wrapper">
      <div class="comparison-top-bar">
        <div>
          <h3 class="comparison-heading">Standard Tradizionale vs Metodo Ethos</h3>
          <span class="comparison-sub">Differenze sostanziali di approccio e monitoraggio</span>
        </div>
        <span class="comparison-pill">Confronto Diretto</span>
      </div>

      <div class="comparison-grid">
        <!-- Header Colonne -->
        <div class="grid-row grid-header">
          <div class="col-param">Parametro</div>
          <div class="col-standard">Palestra Tradizionale</div>
          <div class="col-ethos">
            <span class="ethos-tag">Standard Ethos</span>
            <span>Ethos Training Club</span>
          </div>
        </div>

        <!-- Righe Dati -->
        {comparisonData.map((row) => (
          <div class="grid-row">
            <div class="col-param">
              <strong>{row.label}</strong>
            </div>
            
            <div class="col-standard">
              <span class="status-icon cross" aria-hidden="true">✕</span>
              <span>{row.standard}</span>
            </div>

            <div class="col-ethos">
              <span class="status-icon check" aria-hidden="true">✓</span>
              <span>{row.ethos}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .trifit-section {
    position: relative;
    background-color: #000000;
    color: #ffffff;
    padding: 5rem 1.5rem;
    border-bottom: 1px solid #1a1a1a;
    font-family: 'Inter', sans-serif;
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    width: 100%;
  }

  .section-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 1rem;
    margin-bottom: 2.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #737373;
  }

  .section-number {
    color: #069892;
    font-weight: 700;
  }

  .header-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3.5rem;
    align-items: end;
    margin-bottom: 4.5rem;
  }

  .section-title {
    font-family: 'Michroma', sans-serif;
    font-size: clamp(1.8rem, 3.8vw, 3rem);
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .text-accent {
    color: #069892;
  }

  .section-lead {
    font-size: 1rem;
    line-height: 1.7;
    color: #a3a3a3;
    margin: 0;
    border-left: 2px solid #004f5b;
    padding-left: 1.25rem;
  }

  /* Pillars */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 5rem;
  }

  .pillar-block {
    background-color: #080808;
    border: 1px solid #1a1a1a;
    border-radius: 0.35rem;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease;
  }

  .pillar-block:hover {
    border-color: #004f5b;
  }

  .pillar-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .pillar-id {
    font-family: 'Michroma', sans-serif;
    font-size: 1.25rem;
    color: #069892;
    font-weight: 700;
  }

  .pillar-line {
    flex-grow: 1;
    height: 1px;
    background-color: #1a1a1a;
  }

  .pillar-subtitle {
    display: block;
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #737373;
    margin-bottom: 0.4rem;
  }

  .pillar-title {
    font-family: 'Michroma', sans-serif;
    font-size: 1.05rem;
    color: #ffffff;
    margin: 0 0 1rem 0;
    line-height: 1.3;
  }

  .pillar-desc {
    font-size: 0.875rem;
    color: #a3a3a3;
    line-height: 1.6;
    margin: 0;
  }

  /* Nuova Tabella Comparativa ad Alto Impatto */
  .comparison-wrapper {
    background-color: #050505;
    border: 1px solid #1a1a1a;
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .comparison-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 2rem 1.5rem;
    border-bottom: 1px solid #141414;
    background-color: #080808;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .comparison-heading {
    font-family: 'Michroma', sans-serif;
    font-size: 1.15rem;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 0.25rem 0;
  }

  .comparison-sub {
    font-size: 0.8125rem;
    color: #737373;
  }

  .comparison-pill {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    background-color: #004f5b;
    color: #ffffff;
    border-radius: 0.2rem;
  }

  .comparison-grid {
    display: flex;
    flex-direction: column;
  }

  .grid-row {
    display: grid;
    grid-template-columns: 1fr 1.25fr 1.35fr;
    border-bottom: 1px solid #111111;
    align-items: center;
  }

  .grid-row:last-child {
    border-bottom: none;
  }

  /* Header Colonne */
  .grid-header {
    background-color: #0c0c0c;
    border-bottom: 1px solid #1a1a1a;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .grid-header .col-param {
    color: #737373;
  }

  .grid-header .col-standard {
    color: #888888;
  }

  .grid-header .col-ethos {
    color: #069892;
    background-color: #051415;
    position: relative;
  }

  .ethos-tag {
    position: absolute;
    top: 6px;
    right: 1.5rem;
    font-size: 0.58rem;
    background-color: #069892;
    color: #000000;
    padding: 0.15rem 0.45rem;
    border-radius: 0.15rem;
    letter-spacing: 0.05em;
  }

  /* Celle */
  .col-param {
    padding: 1.25rem 1.5rem;
    font-size: 0.875rem;
    color: #ffffff;
  }

  .col-standard {
    padding: 1.25rem 1.5rem;
    font-size: 0.875rem;
    color: #737373;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-left: 1px solid #111111;
  }

  .col-ethos {
    padding: 1.25rem 1.5rem;
    font-size: 0.875rem;
    color: #ffffff;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: rgba(6, 152, 146, 0.04);
    border-left: 1px solid rgba(6, 152, 146, 0.3);
  }

  /* Icone di Stato */
  .status-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  .status-icon.cross {
    background-color: #141414;
    color: #555555;
  }

  .status-icon.check {
    background-color: rgba(6, 152, 146, 0.2);
    color: #069892;
    font-weight: 700;
  }

  /* Responsive Rules */
  @media (max-width: 900px) {
    .header-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .pillars-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .grid-row {
      grid-template-columns: 1fr;
      padding: 1rem 0;
    }

    .grid-header {
      display: none;
    }

    .col-param {
      padding: 0.5rem 1.25rem 0.25rem;
      border-bottom: 1px solid #141414;
      font-size: 0.95rem;
    }

    .col-standard {
      padding: 0.6rem 1.25rem;
      border-left: none;
    }

    .col-ethos {
      padding: 0.75rem 1.25rem 0.5rem;
      border-left: none;
      border-top: 1px solid rgba(6, 152, 146, 0.2);
      background-color: #051415;
    }
  }

  @media (max-width: 600px) {
    .comparison-top-bar {
      padding: 1.5rem 1.25rem;
    }
  }
</style>