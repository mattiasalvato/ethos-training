---
interface Props {
  logoSrc?: string;
}

const { 
  logoSrc = "/images/logo.png"
} = Astro.props;
---

<header class="navbar-sticky">
  <div class="nav-container">
    
    <!-- Brand Logo -->
    <a href="#" class="brand-link" aria-label="Ethos Training Club Home">
      <img 
        src={logoSrc} 
        alt="Ethos Training Club Logo" 
        class="brand-logo"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Nav Right: Pill + CTA rapida -->
    <div class="nav-right">
      <div class="status-pill">
        <span class="pulse-dot"></span>
        <span class="pill-text">Ultime 30 Tessere <strong>-35%</strong></span>
      </div>

      <a href="#preiscrizione" class="btn-nav">
        Blocca Posto
      </a>
    </div>

  </div>
</header>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .navbar-sticky {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background-color: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.85rem 1.5rem;
    font-family: 'Inter', sans-serif;
  }

  .nav-container {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-logo {
    height: 34px;
    width: auto;
    max-width: 170px;
    object-fit: contain;
    display: block;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .status-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(6, 152, 146, 0.3);
    border-radius: 999px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: #069892;
    border-radius: 50%;
    box-shadow: 0 0 6px #069892;
  }

  .pill-text {
    font-size: 0.72rem;
    color: #a3a3a3;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pill-text strong {
    color: #069892;
    font-weight: 700;
  }

  .btn-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1.15rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    background-color: #069892;
    color: #000000;
    border-radius: 0.25rem;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .btn-nav:hover {
    background-color: #05807a;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .navbar-sticky {
      padding: 0.75rem 1rem;
    }

    .brand-logo {
      height: 28px;
    }

    .status-pill {
      display: none;
    }
  }
</style>