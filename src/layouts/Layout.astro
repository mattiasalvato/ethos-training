---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ethos Training Club | Pre-Iscrizioni Founding Member",
  description = "Boutique Training Club a numero chiuso con metodo TriFit. Blocca la tariffa agevolata Founding Member da 580€ prima dell'esaurimento dei 30 posti disponibili.",
} = Astro.props;
---

<!doctype html>
<html lang="it" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Social Sharing Preview -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Michroma&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-black text-white antialiased">
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    background-color: #000000;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: 'Inter', sans-serif;
    color: #ffffff;
    background-color: #000000;
    overflow-x: hidden;
  }

  /* Barra di scorrimento minimale scura */
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #000000;
  }
  ::-webkit-scrollbar-thumb {
    background: #004f5b;
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #069892;
  }
</style>