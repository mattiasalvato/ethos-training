---
interface Props {
  whatsappNumber?: string;
  maxSpots?: number;
  backgroundImage?: string;
}

const {
  whatsappNumber = "3773364103",
  maxSpots = 30,
  backgroundImage = "/images/gym-preview.jpg",
} = Astro.props;

const whatsappUrl = `https://wa.me/39${whatsappNumber}?text=${encodeURIComponent(
  "Ciao! Vorrei maggiori informazioni sulla promo Founding Member con il 50% di sconto e sulla prova di 15-20 giorni di Ethos Training Club."
)}`;
---

<section class="hero-editorial">
  <div class="hero-bg-layer" style={`background-image: url('${backgroundImage}');`}></div>
  <div class="hero-overlay"></div>
  <div class="top-line"></div>

  <div class="container">
    <div class="meta-bar">
      <div class="meta-label">
        <span class="dot-live"></span>
        <span>Apertura & Pre-Iscrizioni</span>
      </div>
      <div class="scarcity-counter">
        <span>Fase Lancio:</span>
        <strong>Primi {maxSpots} Ingressi</strong>
      </div>
    </div>

    <div class="hero-grid">
      <div class="hero-main">
        <h1 class="headline">
          Il Training Club <br />
          <span class="text-accent">che mancava.</span>
        </h1>

        <div class="usp-row">
          <span class="tag">Metodo TriFit</span>
          <span class="divider">/</span>
          <span class="tag">Mini Class Dedicate</span>
          <span class="divider">/</span>
          <span class="tag">Sala Pesi Assistita</span>
        </div>
      </div>

      <div class="hero-aside">
        <p class="manifesto">
          Uno spazio che unisce la disciplina della Sala Pesi seguita costantemente dal Personal Trainer all'energia delle Mini Class a numero chiuso.
        </p>

        <div class="offer-box">
          <div class="offer-header">
            <span class="offer-badge">Founding Member</span>
            <span class="discount-pill">-50% SCONTO</span>
          </div>

          <div class="offer-statement">
            <h2 class="offer-highlight-title">Quota Agevolata di Lancio</h2>
            <p class="offer-desc">
              Tariffa speciale dimezzata riservata esclusivamente ai primi <strong>{maxSpots} iscritti</strong> prima dell'apertura ufficiale.
            </p>
          </div>

          

          <div class="actions">
            <a href="#preiscrizione" class="btn btn-solid">
              Blocca il Tuo Posto al 50%
            </a>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
              Contattaci via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="stats-strip">
      <div class="stat-col">
        <span class="stat-num">01</span>
        <div class="stat-info">
          <strong>Colloquio con Anamnesi</strong>
          <span>Valutazione della situazione fisica e dei tuoi obiettivi</span>
        </div>
      </div>
      <div class="stat-col">
        <span class="stat-num">02</span>
        <div class="stat-info">
          <strong>Schede ogni 6 Settimane</strong>
          <span>Progressione sartoriale su misura</span>
        </div>
      </div>
      <div class="stat-col">
        <span class="stat-num">03</span>
        <div class="stat-info">
          <strong>Continuo Supporto</strong>
          <span>Allenamento assistito e monitoraggio continuo in sala</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  *, *::before, *::after { box-sizing: border-box; }
  .hero-editorial {
    position: relative;
    background-color: #000000;
    color: #ffffff;
    padding: 3.5rem 1.5rem 4rem;
    border-bottom: 1px solid #1a1a1a;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }
  .hero-bg-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) contrast(110%);
    opacity: 0.18;
    z-index: 1;
    transform: scale(1.02);
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 75% 30%, rgba(0, 79, 91, 0.25) 0%, rgba(0, 0, 0, 0.85) 60%, #000000 100%);
    z-index: 2;
    pointer-events: none;
  }
  .top-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #069892;
    z-index: 10;
  }
  .container {
    position: relative;
    max-width: 1120px;
    margin: 0 auto;
    width: 100%;
    z-index: 5;
  }
  .meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 1.25rem;
    margin-bottom: 3.5rem;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .meta-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #a3a3a3;
  }
  .dot-live {
    width: 7px;
    height: 7px;
    background-color: #069892;
    border-radius: 50%;
  }
  .scarcity-counter { color: #737373; }
  .scarcity-counter strong { color: #ffffff; margin-left: 0.25rem; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: start;
    margin-bottom: 5rem;
  }
  .headline {
    font-family: 'Michroma', sans-serif;
    font-size: clamp(2.2rem, 4.5vw, 3.75rem);
    line-height: 1.12;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0 0 2rem 0;
  }
  .text-accent { color: #069892; }
  .usp-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #a3a3a3;
  }
  .divider { color: #004f5b; }
  .manifesto {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #cccccc;
    margin: 0 0 2.5rem 0;
    border-left: 2px solid #004f5b;
    padding-left: 1.25rem;
  }
  .manifesto strong { color: #ffffff; }
  .offer-box {
    background: rgba(8, 8, 8, 0.95);
    border: 1px solid rgba(6, 152, 146, 0.4);
    border-left: 3px solid #069892;
    backdrop-filter: blur(8px);
    border-radius: 0.5rem;
    padding: 2rem;
  }
  .offer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .offer-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ffffff;
  }
  .discount-pill {
    background-color: #069892;
    color: #000000;
    font-family: 'Michroma', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.65rem;
    border-radius: 0.2rem;
  }
  .offer-statement {
    margin-bottom: 1.5rem;
  }
  .offer-highlight-title {
    font-family: 'Michroma', sans-serif;
    font-size: 1.25rem;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }
  .offer-desc {
    font-size: 0.875rem;
    color: #a3a3a3;
    line-height: 1.6;
    margin: 0;
  }
  .offer-desc strong { color: #ffffff; }
  .savings-banner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: #cccccc;
    background-color: #001a1d;
    border: 1px solid rgba(6, 152, 146, 0.25);
    padding: 0.75rem 0.9rem;
    border-radius: 0.25rem;
    margin-bottom: 1.5rem;
  }
  .savings-icon { color: #069892; font-weight: 700; }
  .actions { display: flex; flex-direction: column; gap: 0.75rem; }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-radius: 0.35rem;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .btn-solid { background-color: #069892; color: #000000; border: 1px solid #069892; }
  .btn-solid:hover { background-color: #05807a; }
  .btn-outline { background-color: transparent; color: #ffffff; border: 1px solid #292929; }
  .btn-outline:hover { border-color: #069892; color: #069892; }
  .stats-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 2.5rem;
  }
  .stat-col { display: flex; align-items: baseline; gap: 1rem; }
  .stat-num { font-family: 'Michroma', sans-serif; font-size: 1.25rem; color: #004f5b; }
  .stat-info { display: flex; flex-direction: column; gap: 0.25rem; }
  .stat-info strong { font-size: 0.9375rem; color: #ffffff; }
  .stat-info span { font-size: 0.8125rem; color: #737373; line-height: 1.4; }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; margin-bottom: 3.5rem; }
    .stats-strip { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 600px) {
    .meta-bar { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
    .offer-box { padding: 1.5rem; }
  }
</style>