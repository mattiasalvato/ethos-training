---
interface Props {
  totalSpots?: number;
  claimedSpots?: number;
}

const {
  totalSpots = 30,
  claimedSpots = 6, // Puoi incrementarlo mano a mano che entrano i lead della seconda tranche
} = Astro.props;

const remainingSpots = totalSpots - claimedSpots;
---

<aside class="scarcity-topbar">
  <div class="scarcity-container">
    <div class="scarcity-left">
      <span class="pulse-beacon"></span>
      <span class="scarcity-text">
        <span class="badge-soldout">1ª TRANCHE SOLD OUT</span> &bull; 
        SBLOCCATE ULTIME <span class="highlight">30 TESSERE FOUNDATION</span> AL -35%
      </span>
    </div>

    <div class="scarcity-right">
      <span class="warning-text">Valido fino al 9 Ottobre ore 23:59</span>
      <a href="#preiscrizione" class="scarcity-cta">Blocca Quota</a>
    </div>
  </div>
</aside>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .scarcity-topbar {
    background-color: #061214;
    border-bottom: 1px solid rgba(6, 152, 146, 0.3);
    padding: 0.5rem 1.25rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    color: #a3a3a3;
    position: relative;
    z-index: 60;
  }

  .scarcity-container {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .scarcity-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .pulse-beacon {
    width: 7px;
    height: 7px;
    background-color: #069892;
    border-radius: 50%;
    box-shadow: 0 0 8px #069892;
    flex-shrink: 0;
  }

  .badge-soldout {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.68rem;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    letter-spacing: 0.05em;
  }

  .scarcity-text {
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .highlight {
    color: #069892;
    font-weight: 800;
  }

  .scarcity-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .warning-text {
    color: #e5e5e5;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .scarcity-cta {
    color: #069892;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-bottom: 1px solid #069892;
    padding-bottom: 1px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .scarcity-cta:hover {
    color: #ffffff;
    border-color: #ffffff;
  }

  @media (max-width: 860px) {
    .warning-text {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .scarcity-topbar {
      padding: 0.45rem 0.85rem;
    }

    .scarcity-text {
      font-size: 0.68rem;
    }

    .badge-soldout {
      font-size: 0.62rem;
    }

    .scarcity-cta {
      font-size: 0.68rem;
    }
  }
</style>