---
interface Props {
  maxSpots?: number;
  logoSrc?: string;
}

const { 
  maxSpots = 30,
  logoSrc = "src/images/logo.png" // Sostituisci questo percorso con il tuo file logo
} = Astro.props;
---

<header class="navbar-sticky">
  <div class="nav-container">
    
    <!-- Brand Logo con Immagine -->
    <a href="#" class="brand-link" aria-label="Ethos Training Club Home">
      <img 
        src={logoSrc} 
        alt="Ethos Training Club Logo" 
        class="brand-logo"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Nav Links & Live Status -->
    <div class="nav-right">
      <div class="scarcity-pill">
        <span class="pulse-dot"></span>
        <span class="pill-text">Founding Member: <strong>Primi {maxSpots}</strong></span>
      </div>

      <a href="#preiscrizione" class="btn-nav">
        Blocca Posto
      </a>
    </div>

  </div>
</header>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .navbar-sticky {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #1a1a1a;
    padding: 0.85rem 1.5rem;
    font-family: 'Inter', sans-serif;
  }

  .nav-container {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-logo {
    height: 36px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    display: block;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .scarcity-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background-color: #080808;
    border: 1px solid #1f1f1f;
    border-radius: 0.25rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: #069892;
    border-radius: 50%;
  }

  .pill-text {
    font-size: 0.75rem;
    color: #a3a3a3;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pill-text strong {
    color: #ffffff;
  }

  .btn-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    background-color: #069892;
    color: #000000;
    border-radius: 0.25rem;
    transition: background-color 0.2s ease;
  }

  .btn-nav:hover {
    background-color: #05807a;
  }

  @media (max-width: 640px) {
    .navbar-sticky {
      padding: 0.75rem 1rem;
    }

    .brand-logo {
      height: 28px;
    }

    .scarcity-pill {
      display: none;
    }
  }
</style>