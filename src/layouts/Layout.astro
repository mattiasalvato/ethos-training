---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Ethos Training Club Trissino | Sala Pesi & Mini Class con PT",
  description = "Training Club a Trissino (Vicenza). Allenamento assistito in Sala Pesi e Mini Class a numero chiuso con Personal Trainer dedicato. Scopri il Metodo TriFit.",
  image = "/images/og-image.jpg",
} = Astro.props;


const canonicalURL = new URL(Astro.url.pathname, "https://www.ethostrainingclub.it");
const ogImageURL = new URL(image, "https://www.ethostrainingclub.it");

// Schema.org per Local SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ExerciseGym",
  "name": "Ethos Training Club",
  "image": ogImageURL.toString(),
  "url": "https://www.ethostrainingclub.it",
  "telephone": "+393773364103",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Trissino",
    "addressRegion": "VI",
    "postalCode": "36070",
    "addressCountry": "IT"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 45.567,
    "longitude": 11.365
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "07:00",
      "closes": "21:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "08:00",
      "closes": "17:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Sunday",
      "opens": "09:00",
      "closes": "13:00"
    }
  ],
  "priceRange": "$$"
};
---

<!doctype html>
<html lang="it" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Meta Verifica Dominio -->
    <meta name="facebook-domain-verification" content="fktwxiuznb3po1rsotp6il33gntco0" />
    
    <!-- Meta GEO Tag per SEO Locale Trissino / Vicenza -->
    <meta name="geo.region" content="IT-VI" />
    <meta name="geo.placename" content="Trissino" />
    <meta name="geo.position" content="45.567;11.365" />
    <meta name="ICBM" content="45.567, 11.365" />

    <!-- Open Graph (Facebook / WhatsApp / LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Ethos Training Club" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Dati Strutturati JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Michroma&display=swap"
      rel="stylesheet"
    />

    <!-- CookieConsent v3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.css" />

    <!-- Meta Pixel Code (attivato al consenso marketing) -->
    <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '3523455854488770');
    fbq('track', 'PageView');
  </script>
    <noscript>
      <img height="1" width="1" style="display:none" 
           src="https://www.facebook.com/tr?id=3523455854488770&ev=PageView&noscript=1"/>
    </noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body class="bg-black text-white antialiased">
    <slot />

    <!-- Widget Floating per Riaprire le Preferenze Cookie -->
    <button 
      type="button" 
      id="cookie-settings-btn"
      class="cookie-floating-btn" 
      data-cc="show-preferencesModal" 
      aria-label="Gestisci preferenze cookie"
      title="Preferenze Cookie"
    >
      <svg class="cookie-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"></path>
        <path d="M8.5 8.5v.01"></path>
        <path d="M7.5 15.5v.01"></path>
        <path d="M15.5 14.5v.01"></path>
        <path d="M11.5 12.5v.01"></path>
      </svg>
      <span class="cookie-label">Cookie</span>
    </button>

    <!-- CookieConsent v3 via ESM Module -->
    <script type="module">
      import * as CookieConsent from 'https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.esm.js';

      if (window.location.hash.includes('cookie-reset')) {
        CookieConsent.reset(true);
      }

      CookieConsent.run({
        autoShow: true,
        guiOptions: {
          consentModal: {
            layout: 'box',
            position: 'bottom right',
            equalWeightButtons: true,
            flipButtons: false
          },
          preferencesModal: {
            layout: 'box',
            position: 'right',
            equalWeightButtons: true,
            flipButtons: false
          }
        },
        categories: {
          necessary: {
            enabled: true,
            readOnly: true
          },
          marketing: {}
        },
        language: {
          default: 'it',
          translations: {
            it: {
              consentModal: {
                title: 'Preferenze Privacy & Cookie',
                description: 'Utilizziamo cookie tecnici indispensabili e cookie di tracciamento per misurare l’efficacia delle nostre campagne pubblicitarie.',
                acceptAllBtn: 'Accetta Tutti',
                acceptNecessaryBtn: 'Rifiuta',
                showPreferencesBtn: 'Personalizza',
                footer: '<a href="/privacy-policy" target="_blank">Informativa Privacy</a>'
              },
              preferencesModal: {
                title: 'Gestione Consensi',
                acceptAllBtn: 'Accetta Tutti',
                acceptNecessaryBtn: 'Rifiuta Tutti',
                savePreferencesBtn: 'Salva Selezione',
                sections: [
                  {
                    title: 'Cookie Tecnici Necessari',
                    description: 'Questi cookie sono indispensabili per il corretto funzionamento della piattaforma.',
                    linkedCategory: 'necessary'
                  },
                  {
                    title: 'Marketing & Misurazione (Meta Pixel)',
                    description: 'Consentono di ottimizzare e analizzare le conversioni delle nostre campagne promozionali.',
                    linkedCategory: 'marketing'
                  }
                ]
              }
            }
          }
        }
      });

      // Gestore click fallback per il pulsante floating
      document.getElementById('cookie-settings-btn')?.addEventListener('click', () => {
        CookieConsent.showPreferences();
      });

      if (window.location.hash.includes('cookie-settings')) {
        CookieConsent.showPreferences();
      }
    </script>
  </body>
</html>

<script is:inline>
  // Rileva e sostituisce ogni € nel testo avvolgendolo con un font leggibile
  document.addEventListener('DOMContentLoaded', () => {
    const walker = document.createTreeWalker(
      document.body,
      NodeFilter.SHOW_TEXT,
      null
    );

    const textNodes = [];
    while (walker.nextNode()) {
      if (walker.currentNode.nodeValue.includes('€')) {
        textNodes.push(walker.currentNode);
      }
    }

    textNodes.forEach((node) => {
      const parent = node.parentNode;
      if (parent && parent.nodeName !== 'SCRIPT' && parent.nodeName !== 'STYLE') {
        const span = document.createElement('span');
        span.innerHTML = node.nodeValue.replace(/€/g, '<span class="clean-euro">€</span>');
        parent.replaceChild(span, node);
      }
    });
  });
</script>

<style is:global>
  .clean-euro {
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    font-weight: 700;
    display: inline-block;
    margin-right: 0.12em;
    font-style: normal;
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    background-color: #000000;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: 'Inter', sans-serif;
    color: #ffffff;
    background-color: #000000;
    overflow-x: hidden;
  }

  /* Barra di scorrimento minimale scura */
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #000000;
  }
  ::-webkit-scrollbar-thumb {
    background: #004f5b;
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #069892;
  }

  /* Widget Floating Cookie */
  .cookie-floating-btn {
    position: fixed;
    bottom: 1.25rem;
    left: 1.25rem;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(6, 152, 146, 0.4);
    color: #a3a3a3;
    padding: 0.55rem 0.85rem;
    border-radius: 9999px;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
  }

  .cookie-floating-btn:hover {
    background: #06181a;
    border-color: #069892;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(6, 152, 146, 0.25);
  }

  .cookie-icon {
    color: #069892;
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .cookie-floating-btn {
      bottom: 1rem;
      left: 1rem;
      padding: 0.5rem;
    }
    .cookie-label {
      display: none;
    }
  }

  /* Attivazione Tema Scuro Nativo & Contrasto CookieConsent */
  :root,
  .cc--darkmode,
  #cc-main {
    --cc-bg: #0d0d0d !important;
    --cc-primary-color: #ffffff !important;
    --cc-secondary-color: #b3b3b3 !important;
    
    /* Bottoni */
    --cc-btn-primary-bg: #069892 !important;
    --cc-btn-primary-color: #000000 !important;
    --cc-btn-primary-hover-bg: #05807a !important;
    --cc-btn-primary-hover-color: #000000 !important;
    
    --cc-btn-secondary-bg: #1a1a1a !important;
    --cc-btn-secondary-color: #ffffff !important;
    --cc-btn-secondary-border: #2a2a2a !important;
    --cc-btn-secondary-hover-bg: #262626 !important;
    --cc-btn-secondary-hover-color: #ffffff !important;
    
    /* Blocchi Accordion Categorie */
    --cc-cookie-category-block-bg: #141414 !important;
    --cc-cookie-category-block-border: #222222 !important;
    --cc-cookie-category-block-hover-bg: #1c1c1c !important;
    
    --cc-separator-border-color: #222222 !important;
    --cc-toggle-bg-off: #2a2a2a !important;
    --cc-toggle-bg-on: #069892 !important;
    --cc-modal-border-radius: 0.35rem !important;
    --cc-btn-border-radius: 0.25rem !important;
  }

  #cc-main {
    font-family: 'Inter', sans-serif !important;
    z-index: 2147483647 !important;
  }

  /* Testi categorie nel modale preferenze */
  #cc-main .section__toggle-wrapper,
  #cc-main .pm__section-title {
    color: #ffffff !important;
    font-weight: 600 !important;
  }

  #cc-main .section__desc,
  #cc-main .pm__section-desc {
    color: #a3a3a3 !important;
  }

  #cc-main .cm__title,
  #cc-main .pm__title {
    font-family: 'Michroma', sans-serif !important;
    text-transform: uppercase !important;
    font-size: 0.95rem !important;
    letter-spacing: -0.01em !important;
    color: #ffffff !important;
  }
</style>